<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. What one phone's installer did says nothing about the next phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="rom_quirks.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="rom_quirks.xml" />
    </device-transfer>
</data-extraction-rules>
